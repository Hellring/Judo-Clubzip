# Copy to .env before running Docker Compose.
# Never commit the real file or paste secret values into chat.

POSTGRES_DB=judo
POSTGRES_USER=judo
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Optional: set this to use an external PostgreSQL instead of the db service.
# DATABASE_URL=postgresql://user:password@db-host:5432/database

# Clerk production credentials.
CLERK_PUBLISHABLE_KEY=pk_live_replace-me
CLERK_SECRET_KEY=sk_live_replace-me
VITE_CLERK_PUBLISHABLE_KEY=pk_live_replace-me

# Optional. For a custom Clerk domain/proxy, use the public URL of this path,
# for example: https://judo.example.com/api/__clerk
VITE_CLERK_PROXY_URL=
# Optional server-side Clerk proxy URL.
# CLERK_PROXY_URL=https://judo.example.com/api/__clerk

# Optional host port for Nginx.
WEB_PORT=80
LOG_LEVEL=info